# Copie este arquivo para android/keystore.properties (NÃO COMMITAR!)
# somente depois de confirmar a chave com:
# npm run android:check:keystore -- /caminho/da/chave.keystore
#
# IMPORTANTE: fingerprint SHA-256 e snippet da Play Console nao sao senhas
# nem chaves privadas e nao devem ser inseridos neste arquivo.
storeFile=visita-sc-release.keystore
storePassword=SUA_SENHA_DO_KEYSTORE
keyAlias=visita-sc
keyPassword=SUA_SENHA_DA_CHAVE
